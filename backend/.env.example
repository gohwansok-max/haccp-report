# backend/.env.example
# 실제 값은 절대 이 파일에 적지 말고, Vercel(또는 사용하는 호스팅)의 환경변수 설정 화면에만 입력한다.
# 이 Backend 프로세스 밖(GitHub Repository, index.html, JS, localStorage, Service Worker 등)으로
# OPENAI_API_KEY가 나가서는 안 된다.

# OpenAI 공식 API Key (필수) - 이 서버 환경에만 존재해야 한다.
OPENAI_API_KEY=

# AI 분석(HACCP 지적사항 추출)에 사용할 모델. 비워두면 기본값(gpt-4.1) 사용.
OPENAI_MODEL=

# 오디오 정밀 전사에 사용할 OpenAI 공식 Transcription 모델. 비워두면 기본값(gpt-4o-transcribe) 사용.
OPENAI_TRANSCRIBE_MODEL=

# CORS 허용 Origin (쉼표로 구분). 예: https://gohwansok-max.github.io
# 비워두거나 "*"로 두면 전체 허용(개인/소규모 사용 기본값, 운영 시에는 좁히는 것을 권장).
ALLOWED_ORIGINS=

# 오디오 업로드 최대 크기(byte). 비워두면 기본값(25MB) 사용.
MAX_AUDIO_UPLOAD_BYTES=

# 분당 IP당 허용 요청 수 (best-effort, 인메모리). 비워두면 기본값(20) 사용.
RATE_LIMIT_PER_MINUTE=
